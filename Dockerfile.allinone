# KeepLocal All-in-One Dockerfile for Unraid
# This Dockerfile combines MongoDB, Node.js Backend, and React Frontend
# into a single container for easy deployment on Unraid.

# Stage 1: Build React Frontend
FROM node:22-alpine AS client-builder

WORKDIR /app/client

# Copy client package files
COPY client/package*.json ./
RUN npm ci

# Copy client source
COPY client/ ./

# Build React app with production settings
# IMPORTANT: REACT_APP_API_URL must be empty because the client code already adds /api prefix
ARG REACT_APP_API_URL=
ARG VITE_API_URL=${REACT_APP_API_URL}
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Stage 2: Build the Python dependencies for the AI service (Top-30 Nr. 29).
# The compile toolchain (build-essential, python3-dev, pkg-config, the
# libav*-dev headers) lives HERE and never reaches the runtime image. The
# requirements ship manylinux wheels for amd64 and arm64; only if a wheel is
# missing does pip compile against the headers — the resulting extension then
# links the libav runtime libraries, which the final stage still carries via
# ffmpeg. Both stages use the same base image, so --prefix=/install produces
# exactly the layout pip would install under /usr/local.
FROM ubuntu:22.04 AS ai-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-pip \
    build-essential \
    python3-dev \
    pkg-config \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavdevice-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /install

# requirements.txt alone, so an ai/ source change no longer rebuilds the
# 469-MB pip layer (worst case under QEMU for two architectures).
COPY ai/requirements.txt ./
# pip layout trap: the freshly upgraded (unpatched) pip puts --prefix installs
# into lib/python3.10/site-packages, while Debian's python3 only searches
# dist-packages. Normalize the tree so the runtime COPY below lands in a
# searched path — the Whisper preload right after the COPY verifies the import
# in this same build instead of on a device.
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel \
    && pip3 install --no-cache-dir --prefix=/install -r requirements.txt \
    && libdir=/install/lib/python3.10 \
    && if [ -d "${libdir}/site-packages" ]; then \
         if [ -d "${libdir}/dist-packages" ]; then \
           cp -a "${libdir}/site-packages/." "${libdir}/dist-packages/" \
             && rm -rf "${libdir}/site-packages"; \
         else \
           mv "${libdir}/site-packages" "${libdir}/dist-packages"; \
         fi; \
       fi \
    && test -d "${libdir}/dist-packages"

# Stage 3: Final All-in-One Image
FROM ubuntu:22.04

ARG WHISPER_MODEL=tiny

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime packages: MongoDB, Node.js, Nginx, Supervisor, Python (for AI).
# No build toolchain here (Top-30 Nr. 29) — build-essential, python3-dev,
# pkg-config and the libav*-dev headers only exist in the ai-builder stage.
# gnupg is needed for `gpg --dearmor` of the MongoDB key inside this RUN and
# is purged again at the end of the same layer. ffmpeg keeps the libav runtime
# libraries in the image in case a Python dependency had to be compiled from
# source in the builder instead of arriving as a wheel.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    curl \
    nginx \
    supervisor \
    python3 \
    ffmpeg \
    && curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc \
       | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg \
    && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" \
       > /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends mongodb-org \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get purge -y gnupg \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create application directory structure
WORKDIR /app

# Create node user for running the Node.js application (security best practice)
RUN groupadd -r node && useradd -r -g node -m node

# Create MongoDB data directory
RUN mkdir -p /data/db && chown -R mongodb:mongodb /data/db

# Create writable data directories for the unprivileged application services.
RUN mkdir -p /app/server/uploads/images /app/server/uploads/temp /var/lib/keeplocal-ai \
    && chown -R node:node /app/server/uploads /var/lib/keeplocal-ai

# Server dependencies first (cache order): package files alone, install as the
# node user, then the full source. A source change no longer re-runs npm ci,
# and node_modules never needs a later chown layer (COPY --chown instead of
# the old chown -R, which duplicated the 78-MB tree).
WORKDIR /app/server
COPY --chown=node:node server/package*.json ./
RUN chown node:node /app/server \
    && su -s /bin/sh node -c "npm ci --omit=dev && npm cache clean --force"
COPY --chown=node:node server/ ./

# AI service: wheels from the builder, then the source (cache order again).
COPY --from=ai-builder /install /usr/local
WORKDIR /app/ai
RUN chown node:node /app/ai
COPY --chown=node:node ai/ ./

# Pre-download the configured Whisper model into a cache readable by the AI user.
ENV WHISPER_MODEL=${WHISPER_MODEL} \
    BAKED_WHISPER_MODEL=${WHISPER_MODEL} \
    HF_HOME=/var/lib/keeplocal-ai
RUN su -s /bin/sh node -c \
    "python3 -c \"import os; from faster_whisper import download_model; download_model(os.environ['WHISPER_MODEL'])\""

# Copy built client from builder
COPY --from=client-builder --chown=node:node /app/client/build /app/client/build

# Return to /app directory
WORKDIR /app

# Copy and configure Nginx
COPY nginx-allinone.conf /etc/nginx/sites-available/default
RUN rm -f /etc/nginx/sites-enabled/default \
    && ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Copy supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Eventlistener, der den Container beendet, wenn ein Programm FATAL wird
# (sonst meldet `docker ps` weiter „Up", während der Dienst tot ist).
COPY tools/supervisord-fatal-exit.sh /usr/local/bin/keeplocal-fatal-exit.sh
RUN chmod +x /usr/local/bin/keeplocal-fatal-exit.sh

# Copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create log directories and route nginx's own logs to the container output.
# supervisord schickt die Programm-Logs nach /dev/stdout; nginx schreibt
# access/error aber selbst in Dateien. Dieselben Symlinks wie im offiziellen
# nginx-Image, damit nginx-Fehler in `docker logs` sichtbar sind.
RUN mkdir -p /var/log/supervisor /var/log/mongodb /var/log/keeplocal \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

# Expose ports
# 80: Nginx (Web UI + API proxy)
EXPOSE 80

# Persist data in volumes
VOLUME ["/data/db", "/app/server/uploads"]

# Environment variables with defaults
ENV NODE_ENV=production \
    PORT=5000 \
    MONGODB_URI=mongodb://localhost:27017/keeplocal \
    ALLOWED_ORIGINS=http://localhost:3000,http://localhost \
    HOST=127.0.0.1 \
    TRUST_PROXY=1 \
    AI_SERVICE_URL=http://localhost:5001 \
    JWT_EXPIRES_IN=7d \
    DEMO_MODE=false \
    DEMO_RESET_INTERVAL_HOURS=6 \
    DEMO_NOTE_LIMIT=100 \
    COOKIE_SECURE="" \
    CLIENT_URL="" \
    GOOGLE_CLIENT_ID="" \
    GOOGLE_CALLBACK_URL="" \
    GITHUB_CLIENT_ID="" \
    GITHUB_CALLBACK_URL=""

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1

# Use entrypoint script to fix permissions before starting services
ENTRYPOINT ["/entrypoint.sh"]
