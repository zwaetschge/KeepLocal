# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/keeplocal

# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0
# Direct split/all-in-one access has one internal Nginx hop. Use 2 only when
# one additional trusted reverse proxy (NPM, Traefik, Caddy) sits in front.
TRUST_PROXY=1

# Health endpoints
# /api/health/ready versteckt Interna (absoluter Uploads-Pfad, DB-Fehlertext,
# AI-Endpunkt) vor anonymen Aufrufern. Fuer Fehlersuche im vertrauten Netz auf
# true setzen; ausserhalb von production ist es ohnehin der Default.
HEALTH_DETAILS=false
# Cache-Fenster fuer Uploads-Schreibtest und AI-Probe in Millisekunden.
HEALTH_PROBE_TTL_MS=30000

# CORS Configuration (comma-separated origins, NO SPACES!)
# Für lokale Entwicklung:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost
# Für Nginx Proxy Manager / Production (füge deine Domain hinzu):
# ALLOWED_ORIGINS=https://keeplocal.deine-domain.de,http://localhost:3000
# Für mehrere Domains:
# ALLOWED_ORIGINS=https://keeplocal.example.com,https://notes.example.com,http://localhost:3000

# JWT Authentication (REQUIRED; no reusable default is provided)
# Generiere ein sicheres Secret mit: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional but recommended: use a separate 32+ character random value.
# Defaults to JWT_SECRET when omitted.
CSRF_SECRET=
# Optional override. Leave empty to detect HTTPS through TRUST_PROXY.
COOKIE_SECURE=

# Exact frontend origin used for OAuth redirects. Match an ALLOWED_ORIGINS entry.
CLIENT_URL=http://localhost:3000

# Whisper model for split-container builds. The all-in-one image defaults to tiny.
# Common values: tiny, base, small, medium, large-v3, turbo
WHISPER_MODEL=base

# Shared secret between the API server and the Whisper service (/transcribe).
# Split deployments MUST set it: without a token the AI service accepts audio
# from anything that can reach it on the backend network. The all-in-one image
# generates one per container start when this is empty.
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=
# Concurrent transcriptions the API hands to the AI service. Keep this equal to
# gunicorn's --workers (1 by default); a higher value only makes requests wait
# until the client timeout instead of answering an honest 429.
MAX_CONCURRENT_TRANSCRIPTIONS=1

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
