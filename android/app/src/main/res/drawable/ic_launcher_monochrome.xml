<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome (themed icon) variant: line art only, because a themed icon
     is tinted from the drawable's alpha — a filled sheet would collapse
     into a single blob. Same geometry as ic_launcher_foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sheet outline (the diagonal edge already reads as the fold) -->
    <path
        android:pathData="M 39.5 28.3 H 61.3 L 72.9 39.9 V 75.4 Q 72.9 79.7 68.5 79.7 H 39.5 Q 35.2 79.7 35.2 75.4 V 32.6 Q 35.2 28.3 39.5 28.3 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2" />

    <!-- Text lines -->
    <path
        android:pathData="M 42.5 46.5 L 64 46.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 42.5 54.5 L 55 54.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- Check badge -->
    <path
        android:pathData="M 63.4 71.7 m -7.8 0 a 7.8 7.8 0 1 0 15.6 0 a 7.8 7.8 0 1 0 -15.6 0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2" />
    <path
        android:pathData="M 59.9 71.9 L 62.4 74.4 L 67.2 69.3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
