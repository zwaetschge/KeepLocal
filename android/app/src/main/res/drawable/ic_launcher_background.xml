<?xml version="1.0" encoding="utf-8"?>
<!-- Terracotta brand gradient, diagonally like the web logo tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M 0 0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#D4887D"
                android:endColor="#B56B55"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
