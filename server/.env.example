# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0
TRUST_PROXY=false

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/keeplocal

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# JWT Authentication
# Required, minimum 32 characters. Generate one with:
#   openssl rand -base64 32
# (Placeholder values containing "your-jwt" are rejected at startup.)
JWT_SECRET=
JWT_EXPIRES_IN=7d
CSRF_SECRET=
COOKIE_SECURE=false

# OAuth Configuration (optional — leave empty to disable)
# Google OAuth: Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth: Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Expensive endpoints (per user, in-memory counters)
# Link previews leave the server towards the internet; transcriptions occupy the
# single Whisper worker for up to 300s. Refusals answer 429 + Retry-After.
LINK_PREVIEW_LIMIT_PER_MINUTE=30
TRANSCRIPTION_LIMIT_PER_HOUR=10
TRANSCRIPTION_LIMIT_PER_DAY=60
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Frontend URL (used for OAuth redirect after login — auto-detected if not set)
CLIENT_URL=http://localhost:3000

# API Documentation (Swagger UI under /api/docs)
# Disabled by default in production (NODE_ENV=production); set to true to expose it.
ENABLE_API_DOCS=true
